# SQLite (local dev, no install). For PostgreSQL/Docker use: postgresql://farm:farm@localhost:5432/farm
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="dev-access-secret-change-in-prod-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-prod-min-32"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
PORT=4000
REDIS_URL="redis://localhost:6379"
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"
PUBLIC_APP_URL="http://localhost:3000"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio12345"
S3_BUCKET="farm-media"
