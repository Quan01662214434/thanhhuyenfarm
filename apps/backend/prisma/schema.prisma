// Enterprise schema: normalized, indexed, soft-delete, audit fields, multi-tenant ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  EMPLOYEE
  GUEST
}

enum PlantHealth {
  HEALTHY
  WATCH
  DISEASED
  RECOVERING
  DEAD
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum NotificationSeverity {
  INFO
  WARNING
  DANGER
  SUCCESS
}

enum MediaKind {
  IMAGE
  DOCUMENT
  VOICE
  OTHER
}

/// SaaS tenant boundary — farms belong to an organization
model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  standardWorkHours Float     @default(8)
  qrConfig  Json?

  users User[]
  farms Farm[]
  jobCategories JobCategory[]
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  birthYear      Int?
  photoUrl       String?
  dailyWage      Float?    @default(0)
  role           UserRole  @default(EMPLOYEE)
  specialty      String?
  kpiScore       Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  lastLoginAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  refreshTokens   RefreshToken[]
  deviceSessions  DeviceSession[]
  tasksAssigned   EmployeeTask[]  @relation("TaskAssignee")
  tasksCreated    EmployeeTask[]  @relation("TaskCreator")
  attendanceLogs  AttendanceLog[]
  activityLogs    ActivityLog[]   @relation("ActorUser")
  notifications   Notification[]
  plantHistories  PlantHistory[]
  mediaFiles      MediaFile[]

  @@index([organizationId])
  @@index([role])
  @@index([deletedAt])
}

model RolePermission {
  id             String   @id @default(cuid())
  organizationId String
  role           UserRole
  permission     String
  createdAt      DateTime @default(now())

  @@unique([organizationId, role, permission])
  @@index([organizationId, role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  jti       String    @unique
  hashed    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceSession {
  id         String   @id @default(cuid())
  userId     String
  userAgent  String?
  ip         String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Farm {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zones        Zone[]
  seasons      Season[]

  @@index([organizationId])
  @@index([deletedAt])
}

model Zone {
  id          String    @id @default(cuid())
  farmId      String
  name        String
  description String?
  address     String?
  vietgapCode String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  farm   Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plants Plant[]

  @@index([farmId])
  @@index([deletedAt])
}

model Plant {
  id                   String       @id @default(cuid())
  plantIndex           Int?
  zoneId               String
  species              String
  plantedAt            DateTime
  health               PlantHealth  @default(HEALTHY)
  statusNote           String?
  qrToken              String       @unique
  estimatedHarvestAt   DateTime?
  aiYieldPrediction    Json?
  currentYieldEstimate Float?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?

  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  histories       PlantHistory[]
  diseases        DiseaseRecord[]
  treatments      Treatment[]
  fertilizers     FertilizerApplication[]
  waterings       WateringLog[]
  harvests        Harvest[]
  tasks           EmployeeTask[]
  media           MediaFile[]      @relation("PlantMedia")
  qrCodes         QrCode[]
  certifications  Certification[]

  @@index([zoneId])
  @@index([health])
  @@index([deletedAt])
}

model PlantHistory {
  id        String   @id @default(cuid())
  plantId   String
  actorId   String?
  title     String
  detail    String?
  metadata  Json?
  createdAt DateTime @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([plantId, createdAt])
}

model DiseaseRecord {
  id          String    @id @default(cuid())
  plantId     String
  name        String
  severity    Int       @default(1)
  detectedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  notes       String?
  aiDetected  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId])
  @@index([detectedAt])
}

model Treatment {
  id          String   @id @default(cuid())
  plantId     String
  product     String
  dosage      String?
  appliedAt   DateTime @default(now())
  appliedById String?
  notes       String?

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, appliedAt])
}

model FertilizerApplication {
  id          String   @id @default(cuid())
  plantId     String
  product     String
  amount      String?
  appliedAt   DateTime @default(now())
  appliedById String?

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, appliedAt])
}

model WateringLog {
  id        String   @id @default(cuid())
  plantId   String
  liters    Float?
  wateredAt DateTime @default(now())
  notes     String?

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, wateredAt])
}

model Harvest {
  id         String   @id @default(cuid())
  plantId    String
  seasonId   String?
  quantityKg Float
  quality    String?
  harvested  DateTime @default(now())
  revenue    Float?

  plant  Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id])

  @@index([plantId])
  @@index([seasonId])
}

model Season {
  id          String    @id @default(cuid())
  farmId      String
  name        String
  startDate   DateTime
  endDate     DateTime
  laborCost   Float     @default(0)
  inputCost   Float     @default(0)
  revenue     Float     @default(0)
  profit      Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  farm     Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  harvests Harvest[]

  @@index([farmId])
  @@index([startDate, endDate])
}

model EmployeeTask {
  id          String     @id @default(cuid())
  plantId     String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  assigneeId  String
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  plant     Plant? @relation(fields: [plantId], references: [id])
  assignee  User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([assigneeId, status])
  @@index([plantId])
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  title      String
  body       String?
  severity   NotificationSeverity @default(INFO)
  readAt     DateTime?
  channels   Json?
  metadata   Json?
  createdAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model QrCode {
  id        String   @id @default(cuid())
  plantId   String
  payload   String
  imageKey  String?
  createdAt DateTime @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId])
}

model JobCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  dailyWage      Float
  standardHours  Float    @default(8)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]

  @@index([organizationId])
}

model AttendanceLog {
  id            String   @id @default(cuid())
  userId        String
  jobCategoryId String?
  checkedIn     DateTime @default(now())
  checkedOut    DateTime?
  workHours     Float?
  dailyWage     Float?
  calculatedSalary Float?
  latitude      Float?
  longitude     Float?
  accuracyM     Float?
  note          String?
  isPaid        Boolean  @default(false)
  paidAt        DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobCategory JobCategory? @relation(fields: [jobCategoryId], references: [id])

  @@index([userId, checkedIn])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorUser", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model MediaFile {
  id         String    @id @default(cuid())
  plantId    String?
  uploadedBy String?
  kind       MediaKind @default(IMAGE)
  storageKey String    @unique
  url        String?
  caption    String?
  takenAt    DateTime?
  createdAt  DateTime  @default(now())

  plant Plant? @relation("PlantMedia", fields: [plantId], references: [id])
  uploader User? @relation(fields: [uploadedBy], references: [id])

  @@index([plantId])
}

model Certification {
  id        String   @id @default(cuid())
  plantId   String
  title     String
  issuer    String?
  validTo   DateTime?
  docKey    String?
  createdAt DateTime @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId])
}
